# Copy this file to .env and fill in real values. Do NOT commit .env.

# --- General ---
NODE_ENV=development
PORT=3000

# --- Database ---
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hallyboutique?schema=public"

# --- Auth / JWT ---
# Secret for signing access tokens. Use a long random string (e.g. openssl rand -hex 64).
JWT_SECRET="change-me"
JWT_EXPIRES_IN=15m
JWT_ISSUER=hallyboutique-api
JWT_AUDIENCE=hallyboutique-web
# Refresh tokens (opaque, SHA256-hashed in DB)
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# --- Email (Resend) ---
# Optional while in sandbox; needed for forgot-password/reset-password.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=60
FRONTEND_RESET_URL="http://localhost:3000/api/auth/reset-password-placeholder"

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:5173"

# --- Wompi (payments) ---
# Sandbox keys have the _test_ prefix. See https://docs.wompi.co
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_INTEGRITY_SECRET="test_integrity_..."
WOMPI_EVENTS_SECRET="test_events_..."
# Where Wompi redirects the customer after payment (informativo, no se usa para confirmar)
WOMPI_REDIRECT_URL="http://localhost:5173/order/confirmation"
WOMPI_API_BASE_URL="https://sandbox.wompi.co/v1"

# --- Envia.com (shipping) ---
ENVIA_TOKEN="change-me"
ENVIA_BASE_URL="https://api-test.envia.com"

# --- Taxes & shipping rules ---
TAX_RATE=0.19
# Free shipping above this amount (COP)
FREE_SHIPPING_THRESHOLD=150000
# Carriers allowed for quote, comma-separated
SHIPPING_CARRIERS="coordinadora,serviEntrega,interRapidisimo,tcc"

# --- Shipping origin (warehouse) ---
SHIPPING_ORIGIN_NUMBER="123"
SHIPPING_ORIGIN_NAME="Hally Boutique"
SHIPPING_ORIGIN_PHONE="+573001234567"
SHIPPING_ORIGIN_STREET="Calle 123 #45-67"
SHIPPING_ORIGIN_CITY="Bogota"
SHIPPING_ORIGIN_STATE="DC"
SHIPPING_ORIGIN_COUNTRY=CO
SHIPPING_ORIGIN_POSTALCODE="110111"
