# Variables para tests de integración (Postgres real vía Docker)
# Valores dummy/sandbox locales — NO son secretos reales, se commitean.
# DATABASE_URL apunta al Postgres de docker-compose.test.yml (puerto 5433),
# distinto del Postgres de desarrollo (5432).

NODE_ENV=test
PORT=3010
DATABASE_URL=postgresql://test:test@localhost:5433/hallyboutique_test
JWT_SECRET=test-integration-secret-not-real
JWT_EXPIRES_IN=15m
JWT_ISSUER=hallyboutique-api
JWT_AUDIENCE=hallyboutique-web
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
CORS_ORIGIN=http://localhost:5173

WOMPI_PUBLIC_KEY=pub_test_integration
WOMPI_PRIVATE_KEY=prv_test_integration
WOMPI_INTEGRITY_SECRET=test_integrity_integration
WOMPI_EVENTS_SECRET=test_events_integration
WOMPI_REDIRECT_URL=http://localhost:5173/order/confirmation
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1

ENVIA_TOKEN=test-integration-token
ENVIA_BASE_URL=https://api-test.envia.com

TAX_RATE=0.19
FREE_SHIPPING_THRESHOLD=150000

SHIPPING_ORIGIN_NUMBER=123
SHIPPING_ORIGIN_NAME=Hally Boutique Test
SHIPPING_ORIGIN_PHONE=+573000000000
SHIPPING_ORIGIN_STREET=Calle Test
SHIPPING_ORIGIN_CITY=Bogota
SHIPPING_ORIGIN_STATE=DC
SHIPPING_ORIGIN_COUNTRY=CO
SHIPPING_ORIGIN_POSTALCODE=110111
SHIPPING_CARRIERS=coordinadora,serviEntrega,interRapidisimo,tcc

JOB_POLL_INTERVAL_MS=10000
JOB_BATCH_SIZE=5

RESEND_API_KEY=re_test_not_real
